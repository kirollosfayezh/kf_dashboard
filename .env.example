# Origin of the kf_backend Express server (no trailing slash, no /api suffix).
# REST calls go to <VITE_API_BASE_URL>/api/... and Socket.io connects to this
# same origin, because the realtime server shares the HTTP server.
#   local:  http://localhost:4000
#   Render: https://kf-backend.onrender.com
VITE_API_BASE_URL=http://localhost:4000

# Optional — the public site the sidebar's "View live site" link points at.
VITE_SITE_URL=
